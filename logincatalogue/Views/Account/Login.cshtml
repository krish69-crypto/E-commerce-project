@model logincatalogue.Models.ViewModel.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<style>
    body {
        margin: 0;
        min-height: 100vh;
        background: radial-gradient(circle at 15% 20%, rgba(59, 130, 246, 0.35), transparent 35%), radial-gradient(circle at 85% 80%, rgba(139, 92, 246, 0.30), transparent 35%), linear-gradient(135deg, #0b1120, #172554, #312e81);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .login-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 35px 15px;
    }

    .login-card {
        width: 100%;
        max-width: 440px;
        padding: 42px 38px;
        background: rgba(255, 255, 255, 0.97);
        border: 1px solid rgba(255, 255, 255, 0.65);
        border-radius: 24px;
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.3);
        animation: appear 0.6s ease;
    }

    .brand-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #4f46e5, #2563eb);
        color: white;
        border-radius: 22px;
        font-size: 32px;
        box-shadow: 0 10px 25px rgba(79, 70, 229, 0.3);
    }

    .login-heading {
        font-size: 30px;
        font-weight: 750;
        letter-spacing: -1px;
        color: #111827;
        margin-bottom: 8px;
    }

    .login-description {
        color: #6b7280;
        font-size: 14px;
        margin-bottom: 30px;
    }

    .login-card .form-label {
        font-size: 14px;
        font-weight: 650;
        color: #374151;
        margin-bottom: 8px;
    }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        top: 50%;
        left: 15px;
        transform: translateY(-50%);
        color: #818cf8;
        font-size: 18px;
        pointer-events: none;
    }

    .login-card .form-control {
        height: 52px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #f8fafc;
        padding: 12px 15px 12px 45px;
        font-size: 14px;
        transition: all 0.25s ease;
    }

        .login-card .form-control:focus {
            background: #fff;
            border-color: #6366f1;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.13);
        }

    .password-input {
        padding-right: 48px !important;
    }

    .password-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        border: 0;
        background: transparent;
        color: #64748b;
        cursor: pointer;
        font-size: 18px;
        padding: 5px;
    }

        .password-toggle:hover {
            color: #4f46e5;
        }

    .login-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin: 18px 0 24px;
        font-size: 13px;
    }

        .login-options .form-check-label {
            color: #64748b;
        }

        .login-options .form-check-input:checked {
            background-color: #4f46e5;
            border-color: #4f46e5;
        }

    .login-link {
        color: #4f46e5;
        text-decoration: none;
        font-weight: 600;
    }

        .login-link:hover {
            color: #312e81;
            text-decoration: underline;
        }

    .login-button {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 12px;
        color: #fff;
        font-size: 15px;
        font-weight: 650;
        background: linear-gradient(100deg, #4f46e5, #2563eb);
        box-shadow: 0 8px 20px rgba(79, 70, 229, 0.24);
        transition: all 0.25s ease;
    }

        .login-button:hover {
            color: white;
            background: linear-gradient(100deg, #4338ca, #1d4ed8);
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(79, 70, 229, 0.35);
        }

        .login-button:active {
            transform: translateY(0);
        }

    .register-text {
        color: #64748b;
        text-align: center;
        font-size: 14px;
        margin: 26px 0 0;
    }

    .security-note {
        text-align: center;
        color: #94a3b8;
        font-size: 12px;
        margin-top: 26px;
    }

        .security-note i {
            color: #10b981;
            margin-right: 5px;
        }

    .validation-summary-errors ul {
        margin-bottom: 0;
        padding-left: 20px;
    }

    .field-validation-error {
        display: block;
        margin-top: 5px;
        font-size: 12px;
    }

    @@keyframes appear {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 480px) {
        .login-card {
            padding: 32px 23px;
            border-radius: 20px;
        }

        .login-heading {
            font-size: 27px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .login-card {
            animation: none;
        }

            .login-card * {
                transition: none !important;
            }
    }
</style>

<div class="login-page">
    <div class="login-card">

        <!-- Logo and heading -->
        <div class="text-center">
            <div class="brand-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>

            <h1 class="login-heading">Welcome Back</h1>

            <p class="login-description">
                Enter your credentials to access your account.
            </p>
        </div>

        <!-- Success message -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

        <!-- Login form -->
        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger py-2 small"
                 role="alert">
            </div>

            <!-- Email -->
            <div class="mb-4">
                <label asp-for="Email" class="form-label">
                    Email Address
                </label>

                <div class="input-wrapper">
                    <i class="bi bi-envelope input-icon"></i>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="name@example.com"
                           autocomplete="username" />
                </div>

                <span asp-validation-for="Email"
                      class="text-danger field-validation-error">
                </span>
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label asp-for="Password" class="form-label">
                    Password
                </label>

                <div class="input-wrapper">
                    <i class="bi bi-lock input-icon"></i>

                    <input asp-for="Password"
                           type="password"
                           id="loginPassword"
                           class="form-control password-input"
                           placeholder="Enter your password"
                           autocomplete="current-password" />

                    <button type="button"
                            class="password-toggle"
                            id="togglePassword"
                            aria-label="Show password"
                            aria-pressed="false">
                        <i class="bi bi-eye" id="eyeIcon"></i>
                    </button>
                </div>

                <span asp-validation-for="Password"
                      class="text-danger field-validation-error">
                </span>
            </div>

            <!-- Remember me and forgot password -->
            <div class="login-options">
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           id="rememberMe"
                           name="RememberMe"
                           value="true" />

                    <label class="form-check-label"
                           for="rememberMe">
                        Remember me
                    </label>
                </div>

                <a asp-controller="Account"
                   asp-action="ChangePassword"
                   class="login-link">
                    Change password?
                </a>
            </div>

            <!-- Submit button -->
            <button type="submit" class="btn login-button">
                Sign In
                <i class="bi bi-arrow-right ms-2"></i>
            </button>

            <!-- Registration link -->
            <p class="register-text">
                Don't have an account?
                <a asp-controller="Account"
                   asp-action="Register"
                   class="login-link">
                    Create account
                </a>
            </p>

            <!-- Security footer -->
            <div class="security-note">
                <i class="bi bi-shield-check"></i>
                Your account security matters to us.


            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const password = document.getElementById("loginPassword");
            const toggle = document.getElementById("togglePassword");
            const eyeIcon = document.getElementById("eyeIcon");

            if (password && toggle && eyeIcon) {
                toggle.addEventListener("click", function () {
                    const isHidden = password.type === "password";

                    password.type = isHidden ? "text" : "password";

                    eyeIcon.className = isHidden
                        ? "bi bi-eye-slash"
                        : "bi bi-eye";

                    toggle.setAttribute(
                        "aria-label",
                        isHidden ? "Hide password" : "Show password"
                    );

                    toggle.setAttribute("aria-pressed", String(isHidden));
                });
            }
        });
    </script>
}
