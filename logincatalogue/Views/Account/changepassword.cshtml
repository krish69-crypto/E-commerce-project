@model logincatalogue.Models.ViewModel.ChangePasswordViewModel

<style>
    .password-page {
        min-height: 78vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 35px 15px;
        background: linear-gradient(135deg, #e0e7ff, #f5f3ff, #dbeafe);
        border-radius: 20px;
    }

    .password-card {
        width: 100%;
        max-width: 460px;
        background: #fff;
        padding: 38px;
        border-radius: 24px;
        box-shadow: 0 20px 55px rgba(30, 41, 90, 0.15);
        border: 1px solid rgba(255,255,255,.8);
    }

    .password-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e0e7ff;
        color: #4338ca;
        border-radius: 22px;
        font-size: 34px;
    }

    .password-title {
        color: #172554;
        font-weight: 750;
        letter-spacing: -.5px;
    }

    .password-subtitle {
        color: #64748b;
        font-size: 14px;
    }

    .password-label {
        color: #334155;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .password-input {
        min-height: 49px;
        border: 1px solid #dbe2ef;
        border-radius: 12px;
        padding: 12px 14px;
        background: #f8fafc;
        transition: .2s;
    }

    .password-input:focus {
        background: #fff;
        border-color: #6366f1;
        box-shadow: 0 0 0 4px rgba(99,102,241,.12);
    }

    .password-submit {
        min-height: 50px;
        border: none;
        border-radius: 12px;
        color: white;
        font-weight: 600;
        background: linear-gradient(135deg, #4f46e5, #2563eb);
        transition: transform .2s, box-shadow .2s;
    }

    .password-submit:hover {
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(79,70,229,.25);
    }

    .password-cancel {
        display: block;
        text-align: center;
        margin-top: 17px;
        color: #64748b;
        text-decoration: none;
        font-size: 14px;
    }

    .password-cancel:hover {
        color: #4338ca;
    }

    @@media (max-width: 480px) {
        .password-card {
            padding: 27px 22px;
        }
    }
</style><div class="password-page">
    <div class="password-card">    <div class="text-center mb-4">
        <div class="password-icon"></div>
        <h2 class="password-title">Change Password</h2>
        <p class="password-subtitle mb-0">
            Secure your account with a new password.
        </p>
    </div>

    <form asp-controller="Account"
          asp-action="ChangePassword"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger small mb-3"></div>



                <div class="mb-3">
            <label asp-for="Email"
                   class="form-label password-label">
                Email
            </label>
            <input asp-for="Email"
                   type="password"
                   class="form-control password-input"
                   placeholder="Enter you email"
                   autocomplete="Email" />
            <span asp-validation-for="Email"
                  class="text-danger small"></span>
        </div>

      

        <div class="mb-3">
            <label asp-for="NewPassword"
                   class="form-label password-label">
                New Password
            </label>
            <input asp-for="NewPassword"
                   type="password"
                   class="form-control password-input"
                   placeholder="Create a new password"
                   autocomplete="new-password" />
            <span asp-validation-for="NewPassword"
                  class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword"
                   class="form-label password-label">
                Confirm New Password
            </label>
            <input asp-for="ConfirmPassword"
                   type="password"
                   class="form-control password-input"
                   placeholder="Re-enter your new password"
                   autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"
                  class="text-danger small"></span>
        </div>

        <button type="submit"
                class="btn password-submit w-100">
            Update Password &rarr;
        </button>

        <a asp-controller="Account"
           asp-action="Login"
           class="password-cancel">
            Cancel and return home
        </a>
    </form>

</div>

</div>@{
<partial name="_ValidationScriptsPartial" />
}